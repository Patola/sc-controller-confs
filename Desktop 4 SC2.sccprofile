{
    "_": "", 
    "buttons": {
        "A": {
            "action": "mode(LGRIP2, button(Keys.KEY_B), LGRIPTOUCH, button(Keys.KEY_O), button(Keys.KEY_F))"
        }, 
        "B": {
            "action": "mode(LGRIP2, button(Keys.KEY_Y), button(Keys.KEY_E))"
        }, 
        "BACK": {
            "action": "button(Keys.KEY_ESC)", 
            "name": "Escape"
        }, 
        "C": {
            "action": "hold(menu('Default.menu'), menu('Default.menu'))"
        }, 
        "LB": {
            "action": "mode(LGRIP, mouse(Rels.REL_WHEEL, 1), button(Keys.KEY_SPACE))"
        }, 
        "LGRIP2": {
            "action": "radialmenu('teste1')"
        }, 
        "RB": {
            "action": "mode(LGRIP, mouse(Rels.REL_WHEEL, -1), button(Keys.KEY_LEFTCTRL))"
        }, 
        "RGRIP": {
            "action": "button(Keys.KEY_LEFTSHIFT)"
        }, 
        "RPAD": {
            "action": "button(Keys.BTN_MIDDLE)"
        }, 
        "START": {
            "action": "mode(LGRIP, button(Keys.KEY_TAB), button(Keys.KEY_ENTER))"
        }, 
        "STICKPRESS": {
            "action": "mode(LGRIP, button(Keys.KEY_TAB), button(Keys.KEY_C))"
        }, 
        "X": {
            "action": "mode(LGRIP2, button(Keys.KEY_T), button(Keys.KEY_R))"
        }, 
        "Y": {
            "action": "mode(LGRIP2, button(Keys.KEY_G), button(Keys.KEY_Q))"
        }
    }, 
    "cpad": {}, 
    "dpad": {
        "action": "dpad(button(Keys.KEY_UP), button(Keys.KEY_DOWN), button(Keys.KEY_LEFT), button(Keys.KEY_RIGHT))"
    }, 
    "gyro": {
        "action": "mode(RGRIP2, gyroabs(Rels.REL_Y, Rels.REL_X), None)"
    }, 
    "is_template": false, 
    "menus": {
